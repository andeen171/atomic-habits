**/.turbo
**/dist
**/dist-artifact
**/dev-dist
**/.expo
**/.cache
**/.astro
.git
.idea
.husky
**/.DS_Store
**/*.log
**/.env
**/.env.*
!**/.env.example
**/*.db
**/*.db-*
apps/native/android
apps/native/ios
apps/web/src-tauri/target
