{
	"name": "server",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"start": "bun run src/index.ts",
		"build": "rm -rf dist && bun build ./src/index.ts --target bun --packages external --outdir dist && cp -r src/db/migrations dist/",
		"check-types": "tsc --noEmit",
		"test": "bun test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@atomic/core": "workspace:*",
		"@better-auth/stripe": "1.7.10",
		"@hono/trpc-server": "^0.4.2",
		"@libsql/client": "^0.15.15",
		"@trpc/server": "^11.8.1",
		"better-auth": "1.7.10",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.10.3",
		"stripe": "22.6.2",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/bun": "^1.3.5",
		"drizzle-kit": "^0.31.11",
		"typescript": "~5.9.3"
	}
}
