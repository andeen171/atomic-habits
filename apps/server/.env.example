# Atomic sync server. Copy to `.env` (Bun loads it automatically) or set real
# environment variables in production. Every optional feature below turns on
# only when all of its variables are set; with NODE_ENV=production a partly
# configured feature stops startup and names the missing variables.

# ── Core ────────────────────────────────────────────────────────────────────
# HTTP port.
PORT=3000

# libSQL database. A local SQLite file by default (relative to the working
# directory), or a Turso database: libsql://<db>-<org>.turso.io
DATABASE_URL=file:./local.db
# Only for Turso / remote libSQL: `turso db tokens create <db>`
DATABASE_AUTH_TOKEN=

# Required in production (NODE_ENV=production). Signs session tokens.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of this server, e.g. https://sync.example.com. Optional for sync
# only (inferred from each request); required when email or billing is on.
BETTER_AUTH_URL=

# Comma-separated browser origins allowed to call the API. Empty = any origin
# (safe: auth uses bearer tokens, never cookies). Native apps are unaffected.
CORS_ORIGINS=

# Behind a reverse proxy: the header carrying the real client IP, used for
# rate limiting (e.g. fly-client-ip, x-real-ip, cf-connecting-ip,
# x-forwarded-for). Leave empty when clients connect directly.
CLIENT_IP_HEADER=

# Comma list of the web app's URLs (allowed return targets after checkout and
# email links; also trusted origins).
APP_WEB_URL=

# json (default in production) or pretty. Logs never contain user content.
LOG_FORMAT=
METRICS_TOKEN=
PRIVACY_URL=
TERMS_URL=

# Latest sideloaded Android build (both or neither): drives the apps'
# "Update available" banner.
ANDROID_LATEST_VERSION=
ANDROID_DOWNLOAD_URL=

# ── Email (verification, password reset) ───────────────────────────────────
# resend | console (development only) | none
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DAILY_CAP=90

# ── Google sign-in (ID tokens) ─────────────────────────────────────────────
# Comma list, web client first, then Android and iOS.
GOOGLE_CLIENT_IDS=
# Web origins that show the Google button (default: the APP_WEB_URL origins).
GOOGLE_WEB_ORIGINS=

# ── Billing (Stripe; needs email in production) ───────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_TRIAL_DAYS=0
BILLING_GRACE_DAYS=14

# ── Plans (MB are MiB) ─────────────────────────────────────────────────────
# Default: pro when billing is off, free when it is on.
DEFAULT_PLAN=
LIMIT_FREE_AI_REQUESTS=10
LIMIT_PRO_AI_REQUESTS=150
LIMIT_FREE_AI_TRANSLATE_CHARS=2000
LIMIT_PRO_AI_TRANSLATE_CHARS=40000
LIMIT_FREE_BLOB_MB=100
LIMIT_PRO_BLOB_MB=5120
LIMIT_FREE_SYNC_MB=50
LIMIT_PRO_SYNC_MB=500
# Largest photo upload, in bytes (default and maximum: 2097152).
BLOB_MAX_FILE_BYTES=

# ── AI beta (an OpenAI-compatible endpoint) ────────────────────────────────
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# json_schema | json_object | prompt
AI_JSON_MODE=json_schema
AI_TIMEOUT_MS=25000
AI_TRANSLATE_TIMEOUT_MS=45000
AI_MAX_CONCURRENCY=2
AI_QUEUE_MAX=8
# Unset: suggest,translate. Set but empty (`AI_FEATURES=`) turns AI off.
# AI_FEATURES=suggest,translate
# self-hosted | hosted (hosted needs AI_PROVIDER_NAME, shown in the consent)
AI_HOSTING=self-hosted
AI_PROVIDER_NAME=
# Applies only while email is on (Google-verified emails count).
AI_REQUIRE_VERIFIED_EMAIL=true
AI_GLOBAL_DAILY_REQUESTS=5000

# ── Photo backup ───────────────────────────────────────────────────────────
# disk | s3 | off
BLOB_STORAGE=disk
BLOB_DIR=./blobs
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
