# Atomic sync server. Copy to `.env` (Bun loads it automatically) or set real
# environment variables in production.

# HTTP port.
PORT=3000

# libSQL database. A local SQLite file by default (relative to the working
# directory), or a Turso database: libsql://<db>-<org>.turso.io
DATABASE_URL=file:./local.db
# Only for Turso / remote libSQL: `turso db tokens create <db>`
DATABASE_AUTH_TOKEN=

# Required in production (NODE_ENV=production). Signs session tokens.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of this server, e.g. https://sync.example.com (optional; inferred
# from each request when empty).
BETTER_AUTH_URL=

# Comma-separated browser origins allowed to call the API. Empty = any origin
# (safe: auth uses bearer tokens, never cookies). Native apps are unaffected.
CORS_ORIGINS=

# Behind a reverse proxy: the header carrying the real client IP, used for
# sign-in rate limiting (e.g. fly-client-ip, x-real-ip, cf-connecting-ip).
# Leave empty when clients connect directly.
CLIENT_IP_HEADER=
