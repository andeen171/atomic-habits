# Atomic Cloud: settings for docker-compose.yml (README.md walks through each).
#
#   cp .env.example .env && chmod 600 .env
#
# This one file feeds compose itself (COMPOSE_PROFILES, DOMAIN, LLAMA_*,
# LITESTREAM_*) and the server's environment (everything else; the server
# ignores names it doesn't know). Every server variable is documented in
# apps/server/README.md. The server runs with NODE_ENV=production: a feature
# with only some of its variables set stops it at startup, naming the
# missing ones. Leave a feature's variables all empty to switch it off.

# ── Compose ────────────────────────────────────────────────────────────────
# tls = Caddy (HTTPS), backup = Litestream to R2, ai = local llama.cpp model.
COMPOSE_PROFILES=tls,backup,ai
# The API's public host name: an A/AAAA record to this machine (DNS only).
DOMAIN=sync.example.com

# ── Server: core ───────────────────────────────────────────────────────────
# Required. openssl rand -base64 32   (changing it signs everyone out)
BETTER_AUTH_SECRET=
# Required with email or billing: the public URL of the API.
BETTER_AUTH_URL=https://sync.example.com
# The web app (Cloudflare Pages): links back to it, allowed return targets.
APP_WEB_URL=https://app.example.com
# Browser origins allowed to call the API (empty = any; auth is bearer-only).
CORS_ORIGINS=
# Shown by the apps.
PRIVACY_URL=https://app.example.com/privacy
TERMS_URL=https://app.example.com/terms
# GET /internal/metrics with "Authorization: Bearer <token>". openssl rand -hex 32
METRICS_TOKEN=
# Latest sideloaded Android build (both or neither): the apps' update banner.
ANDROID_LATEST_VERSION=
ANDROID_DOWNLOAD_URL=

# Database: the default is a SQLite file on the `atomic-data` volume
# (/data/atomic.db), replicated by Litestream. For Turso instead, set both
# and drop `backup` from COMPOSE_PROFILES:
# DATABASE_URL=libsql://atomic-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# ── Email: Resend (free: 100/day, 3,000/month) ─────────────────────────────
# Verification and password reset. A domain verified in Resend is required.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Atomic <no-reply@example.com>"
# Below Resend's free 100/day.
EMAIL_DAILY_CAP=90

# ── Google sign-in (optional) ──────────────────────────────────────────────
# OAuth client ids, web client first, then Android (no client secret).
GOOGLE_CLIENT_IDS=
# Where the web app shows the Google button (default: the APP_WEB_URL origins).
GOOGLE_WEB_ORIGINS=

# ── Billing: Stripe (optional; needs email) ────────────────────────────────
# All three set = billing on, and new accounts start on the free plan.
STRIPE_SECRET_KEY=
# Signing secret of the endpoint https://sync.example.com/api/auth/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_TRIAL_DAYS=0
BILLING_GRACE_DAYS=14

# ── AI beta: the `ai` profile's local model ────────────────────────────────
# Leave AI_BASE_URL and AI_MODEL empty to switch AI off (and drop `ai` above).
AI_BASE_URL=http://llm:8080/v1
AI_MODEL=qwen2.5-1.5b-instruct
# Shared by the server and llama.cpp; required with the `ai` profile.
# openssl rand -hex 24
AI_API_KEY=
AI_JSON_MODE=json_schema
# CPU inference on 4 Ampere cores: roughly 5-15 s per suggestion; long
# translations need more. Check with scripts/ai-eval.ts (p95) and adjust.
AI_TIMEOUT_MS=30000
AI_TRANSLATE_TIMEOUT_MS=90000
# Must match the llm service's parallel slots (-np 2).
AI_MAX_CONCURRENCY=2
AI_QUEUE_MAX=8
AI_HOSTING=self-hosted
AI_REQUIRE_VERIFIED_EMAIL=true
AI_GLOBAL_DAILY_REQUESTS=5000
# Kill switch: uncomment (empty value) to switch AI off without a redeploy of clients.
# AI_FEATURES=
# The llm service (compose only):
LLAMA_THREADS=4
# LLAMA_MODEL=Qwen/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
# LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server@sha256:…

# ── Photo backup: Cloudflare R2 (free: 10 GB, no egress fees) ──────────────
# Bucket atomic-blobs, API token limited to it (Object Read & Write).
BLOB_STORAGE=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=atomic-blobs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Or keep photos on the volume (backed up by backup.sh, not by Litestream):
# BLOB_STORAGE=disk

# ── Litestream: the `backup` profile (compose only) ────────────────────────
# Bucket atomic-backups, its own API token (Object Read & Write).
LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
LITESTREAM_BUCKET=atomic-backups
LITESTREAM_PATH=atomic.db
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ── backup.sh (host) ───────────────────────────────────────────────────────
# Local snapshots kept in deploy/backups (copy them off the machine too).
BACKUP_KEEP=7
